# Copy to `.env` in bantai-backend/. NEVER commit .env.
# All variables use the BANTAI_ prefix. Every value below is optional.

# Folder containing the ML package (src/models/baseline_inference.py).
# Default: <repo>/machine-learning
# BANTAI_ML_DIR=D:/path/to/BANTAI_EmailThreatDetection/machine-learning

# true  = refuse to start if the ML model cannot be loaded (recommended for deployment)
# false = start anyway; /health reports "degraded" (convenient for frontend work)
BANTAI_ML_REQUIRED=false

# Allowed browser origins. Must be a JSON list. Default is the Vite dev server.
BANTAI_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# SQLite database file (created automatically on first start). Default: bantai-backend/bantai.db
# BANTAI_DATABASE_PATH=bantai.db
# Folder with schema.sql / seed.sql / migrations/. Default: <repo>/bantai-database
# BANTAI_SQL_DIR=../bantai-database

# Email verification and password-reset OTP delivery (SMTP with STARTTLS).
# The unprefixed names below are supported; BANTAI_SMTP_* aliases also work.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_FROM_EMAIL=verified-sender@example.com
SMTP_FROM_NAME=Bantai

# Public frontend origin used by the Google OAuth callback.
BANTAI_FRONTEND_BASE_URL=http://localhost:5173

# Google OAuth 2.0 / OpenID Connect. Never put these values in frontend config.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Chrome extension OAuth return allowlist. Set this to the extension ID shown
# at chrome://extensions after loading the unpacked extension.
# BANTAI_EXTENSION_ID=icmpkgdjljldinliogcjcclbdmeefaka

# The default database remains bantai-backend/bantai.db.
# BANTAI_DATABASE_PATH=bantai.db
