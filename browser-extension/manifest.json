{
  "manifest_version": 3,
  "name": "BANTAI Email Threat Scanner",
  "version": "1.0.0",
  "description": "Scan the currently open Gmail message with BANTAI.",
  "icons": {
    "32": "BANTAI-logo.png"
  },
  "action": {
    "default_title": "BANTAI Email Threat Scanner",
    "default_icon": {
      "32": "BANTAI-logo.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "identity",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5173/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "http://127.0.0.1:5173/*",
      "http://localhost:8000/*",
      "http://127.0.0.1:8000/*"
    ]
  }
}
